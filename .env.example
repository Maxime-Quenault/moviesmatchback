NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Server-side Supabase credentials.
# Keep the service role key only on the backend.
SUPABASE_URL=https://your-project.supabase.co
# Optional when SUPABASE_URL is a Postgres connection string.
SUPABASE_API_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# External catalog ingestion.
# Prefer the TMDB v4 read access token. TMDB_API_KEY is also supported.
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
JIKAN_BASE_URL=https://api.jikan.moe/v4

# Optional in development, required in production for POST /v1/titles/sync.
CATALOG_SYNC_TOKEN=change-me
